+void waitAcceptReadable(int listenerFd) {
+  const auto deadline = Clock::now() + std::chrono::seconds(1);
+  for (;;) {
+    const auto remaining = deadline - Clock::now();
+    check(remaining > Clock::duration::zero(), "accept readiness timeout");
+    const auto milliseconds = std::chrono::duration_cast<std::chrono::milliseconds>(remaining);
+    pollfd readiness{listenerFd, POLLIN, 0};
+    const int result = poll(&readiness, 1, static_cast<int>(milliseconds.count()) + 1);
+    if (result < 0 && errno == EINTR) continue;
+    check(result == 1 && (readiness.revents & POLLIN) &&
+              !(readiness.revents & (POLLERR | POLLHUP | POLLNVAL)),
+          "accept readiness unavailable");
+    return;
+  }
+}
+
+void waitBackendWritable(int backendFd) {
+  const auto deadline = Clock::now() + std::chrono::seconds(1);
+  for (;;) {
+    const auto remaining = deadline - Clock::now();
+    check(remaining > Clock::duration::zero(), "backend writable timeout");
+    pollfd readiness{backendFd, POLLOUT, 0};
+    const auto milliseconds = std::chrono::duration_cast<std::chrono::milliseconds>(remaining);
+    const int result = poll(&readiness, 1, static_cast<int>(milliseconds.count()) + 1);
+    if (result < 0 && errno == EINTR) continue;
+    check(result == 1 && (readiness.revents & POLLOUT) &&
+              !(readiness.revents & (POLLERR | POLLHUP | POLLNVAL)),
+          "backend writable unavailable");
+    int error = 0;
+    socklen_t length = sizeof(error);
+    check(getsockopt(backendFd, SOL_SOCKET, SO_ERROR, &error, &length) == 0 && error == 0,
+          "backend connection not established");
+    return;
+  }
+}
