+        return None
+    outstanding = [submitted[i] + 8 - current[key] for i, key in enumerate(keys)]
+    if not all(value > 0 for value in outstanding):
+        return None
+    return {'periodic': [previous, current], 'outstanding': outstanding,
+            'currently_blocked': list(blocked)}
+
+
